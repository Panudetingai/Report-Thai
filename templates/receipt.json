{
  "schemaVersion": "1.0",
  "page": { "size": "A4", "margin": [15, 15, 15, 15], "orientation": "portrait" },
  "fonts": [{ "family": "Sarabun", "embed": true }],
  "user_dict": ["วันที่", "เลขที่", "ใบเสร็จรับเงิน"],
  "bands": [
    {
      "type": "title",
      "height": 52,
      "elements": [
        { "type": "rectangle", "x": 0, "y": 0, "w": 180, "h": 3.5, "fill": "#1F4E79" },
        { "type": "text", "x": 0, "y": 5.5, "w": 180, "h": 11, "font": "Sarabun", "size": 20, "bold": true, "align": "center", "text": "ใบเสร็จรับเงิน", "overflow": "error" },
        { "type": "rectangle", "x": 0, "y": 18, "w": 180, "h": 16, "fill": "#F2F4F7", "stroke": "#D0D7E3", "width": 0.5 },
        { "type": "text", "x": 3, "y": 19.5, "w": 107, "h": 13, "font": "Sarabun", "size": 10, "text": "{{ company.name }}\n{{ company.address }}", "overflow": "wrap" },
        { "type": "text", "x": 114, "y": 19.5, "w": 63, "h": 13, "font": "Sarabun", "size": 10, "align": "right", "text": "เลขที่ {{ doc.no }}\n{{ doc.date }}", "overflow": "wrap" },
        { "type": "text", "x": 3, "y": 35.5, "w": 174, "h": 14, "font": "Sarabun", "size": 10, "text": "ได้รับเงินจาก {{ customer.name }}\n{{ customer.address }}", "overflow": "wrap" },
        { "type": "line", "x": 0, "y": 50.8, "w": 180, "h": 0, "width": 1 },
        { "type": "line", "x": 0, "y": 51.6, "w": 180, "h": 0, "width": 0.5 }
      ]
    },
    {
      "type": "detail",
      "dataSource": "items",
      "height": 8,
      "elements": [
        {
          "type": "table",
          "x": 0, "y": 0, "w": 180, "h": 8,
          "font": "Sarabun", "size": 10,
          "data_source": "items",
          "header_repeat": true,
          "columns": [
            { "width": 15, "header": "ลำดับ", "field": "{{ item.no }}", "align": "center" },
            { "width": 105, "header": "รายการรับชำระ", "field": "{{ item.name }}", "align": "left" },
            { "width": 30, "header": "วิธีชำระ", "field": "{{ item.method }}", "align": "center" },
            { "width": 30, "header": "จำนวน", "field": "{{ item.amount }}", "align": "right" }
          ]
        }
      ]
    },
    {
      "type": "summary",
      "gap_before": 4,
      "height": 42,
      "elements": [
        { "type": "text", "x": 0, "y": 0, "w": 86, "h": 14, "font": "Sarabun", "size": 10, "text": "({{ baht_text }})", "overflow": "wrap" },
        { "type": "rectangle", "x": 90, "y": 0, "w": 90, "h": 13, "fill": "#F2F4F7", "stroke": "#1F4E79", "width": 0.6 },
        { "type": "text", "x": 94, "y": 2.5, "w": 42, "h": 8, "font": "Sarabun", "size": 12, "bold": true, "align": "right", "text": "รับเงิน", "overflow": "error" },
        { "type": "text", "x": 136, "y": 2.5, "w": 40, "h": 8, "font": "Sarabun", "size": 12, "bold": true, "align": "right", "text": "{{ total }}", "overflow": "error" },
        { "type": "line", "x": 19, "y": 24.5, "w": 41, "h": 0, "width": 0.5, "dash": [1, 1.5] },
        { "type": "text", "x": 5, "y": 21, "w": 14, "h": 6, "font": "Sarabun", "size": 10, "text": "(ลงชื่อ)", "overflow": "error" },
        { "type": "text", "x": 60, "y": 21, "w": 25, "h": 6, "font": "Sarabun", "size": 10, "text": "ผู้รับเงิน", "overflow": "error" },
        { "type": "line", "x": 17, "y": 31.5, "w": 60, "h": 0, "width": 0.5, "dash": [1, 1.5] },
        { "type": "text", "x": 13, "y": 28, "w": 4, "h": 6, "font": "Sarabun", "size": 10, "align": "center", "text": "(", "overflow": "error" },
        { "type": "text", "x": 77, "y": 28, "w": 4, "h": 6, "font": "Sarabun", "size": 10, "align": "center", "text": ")", "overflow": "error" },
        { "type": "line", "x": 109, "y": 24.5, "w": 41, "h": 0, "width": 0.5, "dash": [1, 1.5] },
        { "type": "text", "x": 95, "y": 21, "w": 14, "h": 6, "font": "Sarabun", "size": 10, "text": "(ลงชื่อ)", "overflow": "error" },
        { "type": "text", "x": 150, "y": 21, "w": 25, "h": 6, "font": "Sarabun", "size": 10, "text": "ผู้จ่ายเงิน", "overflow": "error" },
        { "type": "line", "x": 107, "y": 31.5, "w": 60, "h": 0, "width": 0.5, "dash": [1, 1.5] },
        { "type": "text", "x": 103, "y": 28, "w": 4, "h": 6, "font": "Sarabun", "size": 10, "align": "center", "text": "(", "overflow": "error" },
        { "type": "text", "x": 167, "y": 28, "w": 4, "h": 6, "font": "Sarabun", "size": 10, "align": "center", "text": ")", "overflow": "error" }
      ]
    },
    {
      "type": "pageFooter",
      "height": 10,
      "elements": [
        { "type": "line", "x": 0, "y": 0, "w": 180, "h": 0, "width": 0.7 },
        { "type": "text", "x": 0, "y": 2, "w": 120, "h": 6, "font": "Sarabun", "size": 8.5, "text": "ขอบคุณที่ใช้บริการ", "overflow": "clip" },
        { "type": "text", "x": 130, "y": 2, "w": 50, "h": 6, "font": "Sarabun", "size": 9, "align": "right", "text": "หน้า {{ page }}/{{ pages }}", "overflow": "error" }
      ]
    }
  ]
}
