{
  "schemaVersion": "1.0",
  "page": { "size": "A4", "margin": [15, 15, 15, 15], "orientation": "portrait" },
  "fonts": [{ "family": "Sarabun", "embed": true }],
  "user_dict": ["วันที่", "เลขที่", "ใบเสนอราคา"],
  "bands": [
    {
      "type": "title",
      "height": 52,
      "elements": [
        { "type": "rectangle", "x": 0, "y": 0, "w": 180, "h": 3.5, "fill": "#1F4E79" },
        { "type": "text", "x": 0, "y": 5.5, "w": 180, "h": 11, "font": "Sarabun", "size": 20, "bold": true, "align": "center", "text": "ใบเสนอราคา", "overflow": "error" },
        { "type": "text", "x": 0, "y": 17, "w": 180, "h": 6, "font": "Sarabun", "size": 10, "align": "center", "text": "{{ company.phone }}", "overflow": "wrap" },
        { "type": "rectangle", "x": 0, "y": 24, "w": 180, "h": 16, "fill": "#F2F4F7", "stroke": "#D0D7E3", "width": 0.5 },
        { "type": "text", "x": 3, "y": 25.5, "w": 107, "h": 13, "font": "Sarabun", "size": 10, "text": "{{ company.name }}\n{{ company.address }}", "overflow": "wrap" },
        { "type": "text", "x": 114, "y": 25.5, "w": 63, "h": 13, "font": "Sarabun", "size": 10, "align": "right", "text": "เลขที่ {{ doc.no }}\n{{ doc.date }}", "overflow": "wrap" },
        { "type": "text", "x": 3, "y": 41, "w": 174, "h": 9.5, "font": "Sarabun", "size": 10, "text": "เรียน {{ customer.name }} {{ customer.address }}", "overflow": "wrap" },
        { "type": "line", "x": 0, "y": 50.8, "w": 180, "h": 0, "width": 1 },
        { "type": "line", "x": 0, "y": 51.6, "w": 180, "h": 0, "width": 0.5 }
      ]
    },
    {
      "type": "detail",
      "dataSource": "items",
      "height": 8,
      "elements": [
        {
          "type": "table",
          "x": 0, "y": 0, "w": 180, "h": 8,
          "font": "Sarabun", "size": 10,
          "data_source": "items",
          "header_repeat": true,
          "columns": [
            { "width": 15, "header": "ลำดับ", "field": "{{ item.no }}", "align": "center" },
            { "width": 95, "header": "รายละเอียด", "field": "{{ item.name }}", "align": "left" },
            { "width": 20, "header": "จำนวน", "field": "{{ item.qty }}", "align": "right" },
            { "width": 25, "header": "ราคา", "field": "{{ item.price }}", "align": "right" },
            { "width": 25, "header": "รวม", "field": "{{ item.amount }}", "align": "right" }
          ]
        }
      ]
    },
    {
      "type": "summary",
      "gap_before": 4,
      "height": 44,
      "elements": [
        { "type": "text", "x": 0, "y": 0, "w": 86, "h": 14, "font": "Sarabun", "size": 10, "text": "({{ baht_text }})", "overflow": "wrap" },
        { "type": "rectangle", "x": 90, "y": 0, "w": 90, "h": 27, "fill": "#F2F4F7", "stroke": "#1F4E79", "width": 0.6 },
        { "type": "text", "x": 94, "y": 2, "w": 42, "h": 7, "font": "Sarabun", "size": 10, "align": "right", "text": "รวม", "overflow": "error" },
        { "type": "text", "x": 136, "y": 2, "w": 40, "h": 7, "font": "Sarabun", "size": 10, "align": "right", "text": "{{ subtotal }}", "overflow": "error" },
        { "type": "text", "x": 94, "y": 9, "w": 42, "h": 7, "font": "Sarabun", "size": 10, "align": "right", "text": "ภาษี 7%", "overflow": "error" },
        { "type": "text", "x": 136, "y": 9, "w": 40, "h": 7, "font": "Sarabun", "size": 10, "align": "right", "text": "{{ vat }}", "overflow": "error" },
        { "type": "line", "x": 94, "y": 16.5, "w": 82, "h": 0, "width": 0.5 },
        { "type": "text", "x": 94, "y": 18, "w": 42, "h": 8, "font": "Sarabun", "size": 12, "bold": true, "align": "right", "text": "สุทธิ", "overflow": "error" },
        { "type": "text", "x": 136, "y": 18, "w": 40, "h": 8, "font": "Sarabun", "size": 12, "bold": true, "align": "right", "text": "{{ total }}", "overflow": "error" },
        { "type": "text", "x": 0, "y": 29, "w": 180, "h": 13, "font": "Sarabun", "size": 10, "text": "ยืนราคา {{ valid_days }} วัน เงื่อนไขชำระ {{ payment }}", "overflow": "wrap" }
      ]
    },
    {
      "type": "pageFooter",
      "height": 10,
      "elements": [
        { "type": "line", "x": 0, "y": 0, "w": 180, "h": 0, "width": 0.7 },
        { "type": "text", "x": 0, "y": 2, "w": 120, "h": 6, "font": "Sarabun", "size": 8.5, "text": "{{ company.phone }}", "overflow": "clip" },
        { "type": "text", "x": 130, "y": 2, "w": 50, "h": 6, "font": "Sarabun", "size": 9, "align": "right", "text": "หน้า {{ page }}/{{ pages }}", "overflow": "error" }
      ]
    }
  ]
}
